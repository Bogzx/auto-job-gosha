# Discord Bot
DISCORD_TOKEN=your-discord-bot-token
ALERT_CHANNEL_ID=0

# Database (default: SQLite)
# DATABASE_URL=sqlite+aiosqlite:///data/jobs.db

# Scheduler interval in minutes (default: 60)
# SCRAPE_INTERVAL_MINUTES=60

# Semantic matching (default: disabled — uses regex fallback)
# USE_SEMANTIC_MATCHING=true
# SEMANTIC_MODEL=all-mpnet-base-v2
# SEMANTIC_THRESHOLD=0.40

# Web dashboard
# SESSION_SECRET=change-me-to-a-random-string
# DISCORD_CLIENT_ID=your-discord-app-client-id
# DISCORD_CLIENT_SECRET=your-discord-app-client-secret
# DISCORD_REDIRECT_URI=http://localhost:8080/callback

# SSH proxy VPS instances (up to 9)
# SSH_KEY_PATH=/root/.ssh/id_rsa
# VPS_1_HOST=1.2.3.4
# VPS_1_USER=ubuntu
# VPS_1_PORT=1080
# VPS_1_KEY=/root/.ssh/id_rsa
