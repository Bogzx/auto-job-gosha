# ── Discord Bot ──────────────────────────────────────────────
DISCORD_TOKEN=your-bot-token-here
ALERT_CHANNEL_ID=123456789012345678

# ── Domain (required for public web dashboard) ──────────────
# Your domain name — Caddy uses this for automatic HTTPS.
# DISCORD_REDIRECT_URI is auto-derived as https://{DOMAIN}/callback
DOMAIN=gosha.example.com

# ── Web Dashboard (Discord OAuth2) ──────────────────────────
# Get these from https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-in-production

# Override the auto-derived redirect URI if needed:
# DISCORD_REDIRECT_URI=https://gosha.example.com/callback

# ── Database (default: SQLite) ──────────────────────────────
# DATABASE_URL=sqlite+aiosqlite:///data/jobs.db

# ── Scheduler ───────────────────────────────────────────────
# SCRAPE_INTERVAL_MINUTES=60

# ── SSH Proxy VPS Instances ─────────────────────────────────
# Default SSH key for all VPS connections.
# Points to the mounted path INSIDE the container (./keys/ -> /root/.ssh/)
SSH_KEY_PATH=/root/.ssh/id_rsa

# Up to 9 VPS instances supported.
# If all use the same key, just set SSH_KEY_PATH above.
VPS_1_HOST=111.111.111.111
VPS_1_USER=ubuntu
VPS_1_PORT=1080
VPS_1_KEY=/root/.ssh/vps1_key

# VPS_2_HOST=222.222.222.222
# VPS_2_USER=ubuntu
# VPS_2_PORT=1081
# VPS_2_KEY=/root/.ssh/vps2_key

# ── Semantic Matching (optional) ────────────────────────────
# USE_SEMANTIC_MATCHING=false
# SEMANTIC_MODEL=all-MiniLM-L6-v2
# SEMANTIC_THRESHOLD=0.40
