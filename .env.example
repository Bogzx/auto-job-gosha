# â”€â”€ Discord Bot â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DISCORD_TOKEN=your-bot-token-here
ALERT_CHANNEL_ID=123456789012345678

# â”€â”€ Admin â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Comma-separated Discord user IDs that can run /scrape_now and /status
# Find your ID: Discord Settings > Advanced > Developer Mode, right-click yourself
ADMIN_DISCORD_IDS=123456789012345678

# â”€â”€ Database (default: SQLite) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# DATABASE_URL=sqlite+aiosqlite:///data/jobs.db

# â”€â”€ Scheduler â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# SCRAPE_INTERVAL_MINUTES=60

# â”€â”€ SSH Proxy VPS Instances â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Default SSH key for all VPS connections.
# Points to the mounted path INSIDE the container (./keys/ -> /home/app/.ssh/)
SSH_KEY_PATH=/home/app/.ssh/id_rsa

# Up to 9 VPS instances supported.
# If all use the same key, just set SSH_KEY_PATH above.
VPS_1_HOST=111.111.111.111
VPS_1_USER=ubuntu
VPS_1_PORT=1080
VPS_1_KEY=/home/app/.ssh/vps1_key

# VPS_2_HOST=222.222.222.222
# VPS_2_USER=ubuntu
# VPS_2_PORT=1081
# VPS_2_KEY=/home/app/.ssh/vps2_key

# â”€â”€ Semantic Matching (enabled by default) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# USE_SEMANTIC_MATCHING=true
# SEMANTIC_MODEL=all-MiniLM-L6-v2
# SEMANTIC_THRESHOLD=0.40

# â”€â”€ AI Cover Letters â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Provider is auto-detected: OpenRouter when OPENROUTER_API_KEY is set,
# Gemini otherwise. Force with LLM_PROVIDER=gemini or LLM_PROVIDER=openrouter.
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# OpenRouter: https://openrouter.ai/keys â€” default model is
# deepseek/deepseek-v4-flash; override with any OpenRouter slug
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# LLM_PROVIDER=

# â”€â”€ Web platform (gosha.bogdantruta.com) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Postgres password for the production docker-compose stack
POSTGRES_PASSWORD=
# Local prod-mode testing only: CADDY_SITE=:8080 (defaults to the real domain)
# CADDY_SITE=
# Random long string â€” sign session cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# OAuth2 credentials from the same Discord application as the bot
# (Developer Portal > OAuth2). Add the redirect URI there too.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Public origin of the site; also derives the OAuth redirect URI
PUBLIC_BASE_URL=https://gosha.bogdantruta.com
# DISCORD_REDIRECT_URI=https://gosha.bogdantruta.com/api/v1/auth/discord/callback
# Server users are auto-joined into for DM alerts (+ fallback invite link)
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=
