# Discord
DISCORD_TOKEN=your-bot-token-here
ALERT_CHANNEL_ID=123456789012345678

# Database (default: sqlite+aiosqlite:///data/jobs.db)
# DATABASE_URL=sqlite+aiosqlite:///data/jobs.db

# Scheduler interval in minutes (default: 60)
# SCRAPE_INTERVAL_MINUTES=60

# Default SSH key for all VPS connections.
# Points to the mounted path INSIDE the container (./keys/ → /root/.ssh/)
SSH_KEY_PATH=/root/.ssh/id_rsa

# Proxy VPS instances (up to 9 supported)
# If all use the same key, just set SSH_KEY_PATH above.
# If each VPS has a different key, set VPS_X_KEY for each.

VPS_1_HOST=111.111.111.111
VPS_1_USER=ubuntu
VPS_1_PORT=1080
VPS_1_KEY=/root/.ssh/vps1_key

VPS_2_HOST=222.222.222.222
VPS_2_USER=ubuntu
VPS_2_PORT=1081
VPS_2_KEY=/root/.ssh/vps2_key

VPS_3_HOST=333.333.333.333
VPS_3_USER=ubuntu
VPS_3_PORT=1082
VPS_3_KEY=/root/.ssh/vps3_key
VPS_3_USER=ubuntu
VPS_3_PORT=1082
