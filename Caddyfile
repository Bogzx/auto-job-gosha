# Caddy config for the GOSHA web platform.
# CADDY_SITE defaults to the production domain (auto-HTTPS via Let's Encrypt).
# For local prod-mode testing: CADDY_SITE=:8080 docker compose -f docker-compose.prod.yml up
{$CADDY_SITE:jobs.bogdantruta.com} {
	encode gzip zstd

	# API -> FastAPI container
	handle /api/* {
		reverse_proxy api:8000
	}

	# SPA: static build with client-side routing fallback
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
